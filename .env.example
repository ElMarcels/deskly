# ==========================================================
# Deskly — Variables de Entorno
# ==========================================================
# Copia este archivo como .env.local y rellena los valores.

# Supabase URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase Anon Key (Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANON-AQUI

# Google Gemini API Key (para el generador de flashcards con IA)
GEMINI_API_KEY=TU-CLAVE-GEMINI-AQUI
